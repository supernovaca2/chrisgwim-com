---
import Base from '../../layouts/Base.astro';
import Letterbox from '../../components/Letterbox.astro';
import PosterGrid from '../../components/PosterGrid.astro';
import {
  getReleases,
  fmtDuration,
  isoDuration,
  laneSlug,
  pad2,
  platformName,
  dateLong,
} from '../../lib/releases';
import { coverThumb } from '../../lib/images';

export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((release, i) => ({
    params: { slug: release.id },
    props: {
      release,
      index: i,
      total: releases.length,
      newer: releases[i - 1] ?? null,
      older: releases[i + 1] ?? null,
      sameLane: releases.filter((r) => r.data.lane === release.data.lane && r.id !== release.id).slice(0, 4),
    },
  }));
}

const { release, index, total, newer, older, sameLane } = Astro.props;
const {
  title, datePublished, cover, primaryUrl, series, genre, lane, durationMs,
  soundcloudUrl, description, tags,
} = release.data;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const coverSrc = base + cover.replace(/^\//, '');
const isSoundCloud = primaryUrl.includes('soundcloud.com');
const primaryPlatform = platformName(primaryUrl);
const site = Astro.site ?? new URL('https://chrisgwim.com');
const pageUrl = new URL(`${base}music/${release.id}/`, site).toString();
// Release number counts from the first release, so it never shifts when a new
// track lands at the top of the list.
const releaseNo = total - index;

const metaDescription = isSoundCloud
  ? `${title} by Chris Gwim, ${genre}, ${fmtDuration(durationMs)}. Released ${datePublished}. Listen on SoundCloud.`
  : `${title} by Chris Gwim, ${genre}, ${fmtDuration(durationMs)}. Released ${datePublished}. Listen on ${primaryPlatform}, SoundCloud, and all major platforms.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: title,
  url: pageUrl,
  image: new URL(coverSrc, site).toString(),
  datePublished,
  duration: isoDuration(durationMs),
  genre,
  byArtist: { '@type': 'MusicGroup', name: 'Chris Gwim', url: site.toString() },
  sameAs: Array.from(new Set([primaryUrl, soundcloudUrl])),
};
---
<Base
  title={`${title} — Chris Gwim`}
  description={metaDescription}
  ogImage={cover}
  jsonLd={jsonLd}
  current="music"
>
  <Letterbox release={release} eyebrow={`Release ${pad2(releaseNo)} · ${dateLong(datePublished)}`} />

  <section class="wrap section notes" aria-label="About this release">
    <div class="notes-copy">
      {description ? (
        <>
          <h2 class="notes-title">Notes</h2>
          <p class="notes-text">{description}</p>
        </>
      ) : (
        <img class="notes-cover" src={coverSrc} alt={`${title} cover art`} width="500" height="500" loading="lazy" />
      )}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
    <dl class="details">
      <div><dt>Released</dt><dd>{dateLong(datePublished)}</dd></div>
      <div><dt>Genre</dt><dd>{genre}</dd></div>
      <div><dt>Lane</dt><dd><a href={`${base}music/#${laneSlug(lane)}`}>{lane}</a></dd></div>
      <div><dt>Length</dt><dd class="tabular">{fmtDuration(durationMs)}</dd></div>
      {series && <div><dt>Series</dt><dd>{series}</dd></div>}
      <div><dt>Written and produced by</dt><dd>Chris Gwim</dd></div>
    </dl>
  </section>

  {sameLane.length > 0 && (
    <section class="wrap section" aria-labelledby="lane-h">
      <div class="section-head">
        <h2 class="section-title" id="lane-h">More {lane}</h2>
        <p class="section-aside"><a href={`${base}music/#${laneSlug(lane)}`}>The whole lane</a></p>
      </div>
      <PosterGrid releases={sameLane} variant="feature" />
    </section>
  )}

  <nav class="wrap adjacent" aria-label="Adjacent releases">
    {older ? (
      <a class="adjacent-link" href={`${base}music/${older.id}/`}>
        <img src={coverThumb(older.data.cover, base)} alt="" width="64" height="64" loading="lazy" />
        <span><span class="adjacent-dir">← Previous</span><span class="adjacent-title">{older.data.title}</span></span>
      </a>
    ) : <span aria-hidden="true"></span>}
    <a class="adjacent-link adjacent-all" href={`${base}music/`}>
      <span><span class="adjacent-dir">Catalog</span><span class="adjacent-title">All {total} releases</span></span>
    </a>
    {newer ? (
      <a class="adjacent-link adjacent-next" href={`${base}music/${newer.id}/`}>
        <span><span class="adjacent-dir">Next →</span><span class="adjacent-title">{newer.data.title}</span></span>
        <img src={coverThumb(newer.data.cover, base)} alt="" width="64" height="64" loading="lazy" />
      </a>
    ) : <span aria-hidden="true"></span>}
  </nav>
</Base>

<style>
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 40px 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .notes { grid-template-columns: minmax(0, 1fr); }
  }
  .notes-title {
    margin: 0 0 16px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 32px;
    text-transform: uppercase;
  }
  .notes-text {
    margin: 0;
    max-width: 62ch;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-soft);
  }
  .notes-cover {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    aspect-ratio: 1;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
  }
  .tags li {
    padding: 6px 10px;
    border: 1px solid var(--line-strong);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .details {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .details div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .details dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .details dd {
    margin: 0;
    text-align: right;
    font-size: 15px;
  }
  .details a:hover,
  .details a:focus-visible { color: var(--accent); }
  .adjacent {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    padding-block: 24px 80px;
  }
  @media (max-width: 700px) {
    .adjacent { grid-template-columns: 1fr; }
    .adjacent > span { display: none; }
  }
  .adjacent-link {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--panel);
    text-decoration: none;
  }
  .adjacent-link:hover,
  .adjacent-link:focus-visible { border-color: var(--text-dim); }
  .adjacent-next { justify-content: flex-end; text-align: right; }
  .adjacent-all { justify-content: center; text-align: center; padding-inline: 24px; }
  .adjacent-link img { flex: none; width: 64px; height: 64px; object-fit: cover; }
  .adjacent-link > span { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .adjacent-dir {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .adjacent-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .adjacent-link:hover .adjacent-title,
  .adjacent-link:focus-visible .adjacent-title { color: var(--accent); }
</style>
