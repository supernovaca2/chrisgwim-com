---
import Base from '../../layouts/Base.astro';
import PosterGrid from '../../components/PosterGrid.astro';
import ClassicalSeries from '../../components/ClassicalSeries.astro';
import { getReleases, LANES, laneSlug, pad2, dateLong } from '../../lib/releases';

const releases = await getReleases();
const first = releases[releases.length - 1];
const lanes = LANES.map((lane) => ({
  ...lane,
  slug: laneSlug(lane.name),
  count: releases.filter((r) => r.data.lane === lane.name).length,
})).filter((lane) => lane.count > 0);
---
<Base
  title="Catalog — Chris Gwim"
  description={`Every Chris Gwim release: ${releases.length} tracks with cover art, genre, length, and streaming links, filterable by lane.`}
  current="music"
>
  <section class="wrap section catalog" aria-labelledby="catalog-h">
    <p class="eyebrow">{releases.length} releases since {dateLong(first.data.datePublished)}</p>
    <div class="section-head">
      <h1 class="page-title" id="catalog-h">The catalog</h1>
      <p class="section-aside count" aria-live="polite">{pad2(releases.length)} releases</p>
    </div>
    <div class="chips" role="group" aria-label="Filter by lane">
      <button type="button" class="chip" data-lane="" aria-pressed="true">All <span class="chip-count">{pad2(releases.length)}</span></button>
      {lanes.map((lane) => (
        <button type="button" class="chip" data-lane={lane.slug} aria-pressed="false" id={lane.slug}>
          {lane.name} <span class="chip-count">{pad2(lane.count)}</span>
        </button>
      ))}
    </div>
    <PosterGrid releases={releases} showDate />
  </section>

  <ClassicalSeries releases={releases} />
</Base>

<script>
  // Progressive enhancement: without JS every poster shows. With it, the chips
  // filter by lane and the URL hash carries the selection, so a link can open a
  // filtered catalog (/music/#piano). /music/#series is not a lane: it scrolls
  // to the classical series below the wall.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const posters = Array.from(document.querySelectorAll<HTMLElement>('.poster'));
  const count = document.querySelector<HTMLElement>('.count');
  const total = posters.length;
  const pad = (n: number) => String(n).padStart(2, '0');

  function apply(lane: string) {
    let shown = 0;
    for (const poster of posters) {
      const match = !lane || poster.dataset.lane === lane;
      poster.hidden = !match;
      if (match) shown += 1;
    }
    for (const chip of chips) chip.setAttribute('aria-pressed', String((chip.dataset.lane ?? '') === lane));
    if (count) count.textContent = lane ? `${pad(shown)} of ${pad(total)} releases` : `${pad(total)} releases`;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const lane = chip.dataset.lane ?? '';
      apply(lane);
      history.replaceState(null, '', lane ? `#${lane}` : location.pathname);
    });
  }

  const initial = location.hash.slice(1);
  if (initial && chips.some((c) => c.dataset.lane === initial)) apply(initial);
</script>

<style>
  .catalog { padding-top: 64px; }
  .page-title {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(56px, 8vw, 120px);
    line-height: 0.85;
    text-transform: uppercase;
  }
</style>
