---
import Base from '../../layouts/Base.astro';
import TrackList from '../../components/TrackList.astro';
import { getReleases, LANES, laneSlug, pad2 } from '../../lib/releases';

const releases = await getReleases();
const lanes = LANES.map((lane) => ({
  ...lane,
  slug: laneSlug(lane.name),
  count: releases.filter((r) => r.data.lane === lane.name).length,
})).filter((lane) => lane.count > 0);
---
<Base
  title="Track List — Chris Gwim"
  description={`Every Chris Gwim release: ${releases.length} tracks with cover art, genre, length, and streaming links, filterable by bus.`}
  current="music"
>
  <div class="catalog">
    <TrackList releases={releases} headingId="catalog-h" level={1}>
      <div class="filters" slot="controls" role="group" aria-label="Filter by bus">
        <button type="button" class="chip" data-lane="" aria-pressed="true">ALL {pad2(releases.length)}</button>
        {lanes.map((lane) => (
          <button type="button" class="chip" data-lane={lane.slug} aria-pressed="false" id={lane.slug}>
            <span class="chip-bus">{lane.bus}</span> {lane.name} <span class="chip-count">{pad2(lane.count)}</span>
          </button>
        ))}
      </div>
    </TrackList>
  </div>
</Base>

<script>
  // Progressive enhancement: without JS every row shows. With it, the chips
  // filter rows by lane and the URL hash carries the selection so the home
  // page's bus cards can deep-link into a filtered list.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.track-row-wrap'));
  const count = document.querySelector<HTMLElement>('.section-count');
  const total = rows.length;

  function apply(lane: string) {
    let shown = 0;
    for (const row of rows) {
      const match = !lane || row.dataset.lane === lane;
      row.hidden = !match;
      if (match) {
        shown += 1;
        const num = row.querySelector<HTMLElement>('.track-num');
        if (num) num.textContent = String(shown).padStart(2, '0');
      }
    }
    for (const chip of chips) chip.setAttribute('aria-pressed', String((chip.dataset.lane ?? '') === lane));
    if (count) count.textContent = lane ? `${String(shown).padStart(2, '0')} of ${String(total).padStart(2, '0')} releases` : `${String(total).padStart(2, '0')} releases`;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const lane = chip.dataset.lane ?? '';
      apply(lane);
      history.replaceState(null, '', lane ? `#${lane}` : location.pathname);
    });
  }

  const initial = location.hash.slice(1);
  if (initial && chips.some((c) => c.dataset.lane === initial)) apply(initial);
</script>

<style>
  .catalog { padding-top: 40px; }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 14px;
  }
  .chip {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 6px 10px;
    cursor: pointer;
  }
  .chip:hover { color: var(--text); border-color: var(--text-dimmer); }
  .chip[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent-dim);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .chip-bus { color: var(--text-dimmer); }
  .chip[aria-pressed="true"] .chip-bus { color: var(--accent-dim); }
  .chip-count { color: var(--text-dimmer); }
</style>
