---
// GitHub Pages serves dist/404.html for any unknown path. The SoundCloud sync
// deletes a release page when its track goes private, so old shared links land here.
import Base from '../layouts/Base.astro';
import { getReleases } from '../lib/releases';

const latest = (await getReleases())[0];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<Base
  title="Not showing — Chris Gwim"
  description="This page is not on chrisgwim.com. The full catalog is one click away."
  noindex
>
  <section class="wrap lost">
    <p class="eyebrow">Error 404 · not showing</p>
    <h1 class="lost-title">This reel<br />is missing.</h1>
    <p class="lost-copy">
      The track may have been pulled from the catalog, or the link is mistyped.
      Everything that is out right now is in the catalog.
    </p>
    <div class="lost-actions">
      <a class="btn btn-primary" href={`${base}music/`}>The catalog</a>
      <a class="btn" href={`${base}music/${latest.id}/`}>Now showing: {latest.data.title}</a>
      <a class="btn" href={base}>Home</a>
    </div>
  </section>
</Base>

<style>
  .lost { padding-block: 96px 112px; }
  .lost-title {
    margin: 0 0 24px;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(64px, 11vw, 176px);
    line-height: 0.84;
    text-transform: uppercase;
  }
  .lost-copy {
    margin: 0 0 32px;
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-soft);
  }
  .lost-actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
