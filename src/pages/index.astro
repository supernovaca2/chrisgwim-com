---
// The home page is the hub (2026-11-15): the newest release as a premiere,
// every place the music can be heard, the last few releases, the house promos,
// and who Chris Gwim is with the profiles to follow. It replaced Wave Invasion
// as the front door; the game is at /play/. Nothing here is typed by hand per
// release: the SoundCloud sync adds a track and this page follows.
import Base from '../layouts/Base.astro';
import PosterGrid from '../components/PosterGrid.astro';
import { getReleases, LANES, PLATFORMS, dateShort, fmtDuration } from '../lib/releases';
import { coverLarge } from '../lib/cover-large';
import { LUNTHRA_URL, REFERRAL_URL, YOUTUBE_CHANNEL_URL } from '../lib/site';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const releases = await getReleases();
const [newest, ...earlier] = releases;
const first = releases[releases.length - 1];
const lane = LANES.find((l) => l.name === newest.data.lane);
const lanesInUse = LANES.filter((l) => releases.some((r) => r.data.lane === l.name)).length;
const heroArt = await coverLarge(newest.data.cover, base);
const year = (iso: string) => iso.slice(0, 4);
const monthYear = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
// The title is set as large as its length allows: "Nebula 2.0" fills the
// screen, "Tchaikovsky Swan Lake Enchanted" must not.
const titleLength = newest.data.title.length;
const titleSize = titleLength <= 12 ? 'xl' : titleLength <= 22 ? 'lg' : 'md';
const profile = (name: string) => PLATFORMS.find((p) => p.name === name)!.url;
const follow = [
  { name: 'Spotify', note: 'Artist page', url: profile('Spotify') },
  { name: 'SoundCloud', note: 'soundcloud.com/chrisgwim', url: profile('SoundCloud') },
  { name: 'YouTube', note: '@chrisgwim', url: YOUTUBE_CHANNEL_URL },
];
---
<Base
  title="Chris Gwim — Producer"
  description={`Chris Gwim, producer: ${releases.length} releases across ${lanesInUse} lanes, from classical fusion and melodic techno to piano and synth punk. New release: ${newest.data.title}. Listen on Spotify, Apple Music, SoundCloud and YouTube.`}
  current="home"
  studio={false}
>
  <h1 class="visually-hidden">Chris Gwim, producer</h1>

  <section class="hero" aria-labelledby="hero-h">
    <img class="hero-art" src={heroArt} alt="" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">New release · {dateShort(newest.data.datePublished)}, {year(newest.data.datePublished)} · {newest.data.lane}</p>
      <h2 class:list={['hero-title', titleSize]} id="hero-h">{newest.data.title}</h2>
      <p class="hero-line">
        Written and produced by Chris Gwim. {lane && `${lane.blurb}. `}<span class="tabular">{fmtDuration(newest.data.durationMs)}</span>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}music/${newest.id}/`}>Listen now</a>
        <a class="btn hero-follow" href={profile('Spotify')} target="_blank" rel="noopener">
          Follow on Spotify
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <nav class="listen" aria-label="Streaming platforms">
    <div class="wrap listen-row">
      <span class="listen-label">Listen on</span>
      {PLATFORMS.map((p) => (
        <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
      ))}
    </div>
  </nav>

  <section class="wrap section" aria-labelledby="showing-h">
    <div class="section-head">
      <h2 class="section-title" id="showing-h">Now showing</h2>
      <p class="section-aside showing-links">
        <a href={`${base}music/`}>The whole catalog, {releases.length} releases</a>
        <a href={`${base}music/#series`}>The classical series</a>
      </p>
    </div>
    <PosterGrid releases={earlier.slice(0, 4)} variant="feature" showDate />
  </section>

  <section class="wrap promos" aria-labelledby="also-h">
    <h2 class="promos-label" id="also-h">Also from Chris Gwim</h2>
    <ul class="promo-grid">
      <li>
        <a class="promo" href={`${base}play/`}>
          <span class="promo-mark">Wave<br /><span class="hot">Invasion</span></span>
          <span class="promo-copy">The catalog as an arcade shooter. Play it in your browser.</span>
        </a>
      </li>
      <li>
        <a class="promo promo-light" href={LUNTHRA_URL} target="_blank" rel="noopener">
          <span class="promo-mark">Lunthra<br />apparel</span>
          <span class="promo-copy">Science and sci-fi apparel, printed to&nbsp;order&nbsp;↗</span>
        </a>
      </li>
      <li>
        <a class="promo" href={REFERRAL_URL} target="_blank" rel="noopener">
          <span class="promo-mark">Artist<br />Pro</span>
          <span class="promo-copy">For producers: a free month of SoundCloud Artist&nbsp;Pro&nbsp;↗</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="wrap about" aria-labelledby="about-h">
    <img class="about-photo" src={`${base}artist-portrait.jpg`} alt="Chris Gwim" width="960" height="1200" loading="lazy" />
    <div class="about-copy">
      <p class="eyebrow">Written and produced by</p>
      <h2 class="about-title" id="about-h">Chris<br />Gwim</h2>
      <p>
        Chris Gwim is a producer. The instrument is Ableton Live; the output is whatever the
        idea needs. {releases.length} releases since {monthYear(first.data.datePublished)}.
      </p>
      <p>No live dates. The work is the catalog. Press play.</p>
      <a class="about-link" href={`${base}story/`}>Read the story</a>
    </div>
    <div class="follow" id="follow">
      <h2 class="follow-label">Follow</h2>
      <ul>
        {follow.map((f) => (
          <li>
            <a href={f.url} target="_blank" rel="noopener">{f.name}<span>{f.note}</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* The premiere: the newest release's art edge to edge, its title as large as it fits. */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(520px, 50vw, 720px);
    overflow: hidden;
    background: #000;
  }
  .hero-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  /* Dark on the left where the words are, clear on the right where the art is,
     and a fade into the page at the bottom edge. */
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 9, 11, 0) 72%, var(--bg) 100%),
      linear-gradient(90deg, rgba(8, 9, 11, 0.94) 0%, rgba(8, 9, 11, 0.62) 46%, rgba(8, 9, 11, 0.08) 100%);
  }
  .hero-copy {
    position: relative;
    width: 100%;
    padding-block: 96px 56px;
  }
  .hero-title {
    margin: 0 0 24px;
    font-family: var(--display);
    font-weight: 900;
    line-height: 0.84;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-title.xl { font-size: clamp(76px, 15vw, 228px); }
  .hero-title.lg { font-size: clamp(60px, 11vw, 168px); }
  .hero-title.md { font-size: clamp(52px, 8vw, 128px); }
  .hero-line {
    margin: 0 0 32px;
    max-width: 46ch;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
  }
  .hero-follow { border-color: var(--text); }
  .hero-follow:hover,
  .hero-follow:focus-visible { background: var(--text); color: var(--bg); }

  /* Every place the music can be heard, one line under the premiere. */
  .listen { border-bottom: 1px solid var(--line); }
  .listen-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 40px;
    padding-block: 12px;
  }
  .listen-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .listen a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .listen a:hover,
  .listen a:focus-visible { color: var(--accent); }

  .showing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  /* House promos: the game, the sibling brand, the referral. */
  .promos { padding-block: 40px; }
  .promos-label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .promo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .promo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    height: 100%;
    min-height: 220px;
    padding: 28px;
    background: var(--panel);
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .promo:hover,
  .promo:focus-visible { border-color: var(--text); }
  .promo-mark {
    font-family: var(--display);
    font-weight: 900;
    font-size: 56px;
    line-height: 0.86;
    text-transform: uppercase;
  }
  .hot { color: var(--accent); }
  .promo-copy {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .promo-light {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .promo-light .promo-copy { color: var(--bg); }
  .promo-light:hover,
  .promo-light:focus-visible { background: #fff; border-color: #fff; }

  /* Who it is, and where to follow. */
  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 48px;
    align-items: start;
    padding-block: 80px;
  }
  .about-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--panel);
  }
  .about-title {
    margin: 0 0 24px;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(64px, 7vw, 104px);
    line-height: 0.84;
    text-transform: uppercase;
  }
  .about-copy p:not(.eyebrow) {
    margin: 0 0 16px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .about-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .about-link:hover,
  .about-link:focus-visible { color: var(--accent); }
  .follow { scroll-margin-top: 24px; }
  .follow-label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .follow ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .follow a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-weight: 800;
    font-size: 28px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .follow a span {
    font-family: var(--body);
    font-size: 13px;
    font-weight: 400;
    text-transform: none;
    color: var(--text-dim);
  }
  .follow a:hover,
  .follow a:focus-visible { color: var(--accent); }
</style>
