---
import Base from '../layouts/Base.astro';
import Featured from '../components/Featured.astro';
import Lanes from '../components/Lanes.astro';
import TrackList from '../components/TrackList.astro';
import Outputs from '../components/Outputs.astro';
import Promo from '../components/Promo.astro';
import { getReleases, LANES, pad2 } from '../lib/releases';

const releases = await getReleases();
const latest = releases[0];
const lanesInUse = LANES.filter((l) => releases.some((r) => r.data.lane === l.name));
const firstYear = releases[releases.length - 1].data.datePublished.slice(0, 4);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<Base
  title="Chris Gwim — Producer"
  description={`Chris Gwim: ${releases.length} releases on ${lanesInUse.length} buses, from classical fusion and melodic techno to piano and synth punk. Latest: ${latest.data.title}.`}
  current="index"
>
  <section class="hero">
    <div class="dial" aria-hidden="true"><div class="dial-ticks"></div></div>
    <div class="hero-grid">
      <div class="operator-frame">
        <div class="operator-label">
          <span>OPERATOR</span>
          <span class="rec">● LIVE</span>
        </div>
        <img src={`${base}artist-portrait.jpg`} alt="Chris Gwim" width="480" height="640" />
      </div>
      <div class="hero-content">
        <p class="kicker">Producer · Classical Fusion / Techno / Electronic</p>
        <h1 class="wordmark">Chris <em>Gwim</em></h1>
        <p class="tagline">
          {pad2(releases.length)} releases on {pad2(lanesInUse.length)} buses, from classical fusion to synth punk. Ableton Live is the instrument. Press play.
        </p>
        <div class="spec-row">
          <span class="spec">STATUS <b>LIVE</b></span>
          <span class="spec">RELEASES <b>{pad2(releases.length)}</b></span>
          <span class="spec">BUSES <b>{pad2(lanesInUse.length)}</b></span>
          <span class="spec">SINCE <b>{firstYear}</b></span>
          <span class="spec">LATEST <b>{latest.data.title.toUpperCase()}</b></span>
        </div>
      </div>
    </div>
  </section>

  <Featured release={latest} />
  <Lanes />
  <TrackList releases={releases.slice(0, 10)} total={releases.length} />
  <div class="rack"><Outputs /></div>
  <div class="rack"><Promo /></div>
</Base>

<style>
  .hero {
    position: relative;
    padding: 52px 12px 40px;
    overflow: hidden;
  }
  .dial {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 640px;
    height: 640px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 8%, transparent);
    opacity: 0.6;
    pointer-events: none;
  }
  .dial::before {
    content: "";
    position: absolute;
    inset: 70px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .dial::after {
    content: "";
    position: absolute;
    inset: 140px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .dial-ticks {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(color-mix(in srgb, var(--accent) 10%, transparent) 0deg 1deg, transparent 1deg 15deg);
    -webkit-mask: radial-gradient(circle, transparent 60%, black 61%, black 63%, transparent 64%);
    mask: radial-gradient(circle, transparent 60%, black 61%, black 63%, transparent 64%);
    border-radius: 50%;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 184px 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 560px) {
    .hero-grid { grid-template-columns: 1fr; }
    .operator-frame { max-width: 220px; }
  }
  .operator-frame {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .operator-label {
    display: flex;
    justify-content: space-between;
    padding: 7px 9px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dimmer);
  }
  .operator-label .rec { color: var(--red); }
  .operator-frame img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
  }
  .hero-content { position: relative; min-width: 0; }
  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(56px, 12vw, 112px);
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin: 0;
    line-height: 0.88;
    text-wrap: balance;
  }
  .wordmark em { font-style: normal; color: var(--text-dimmer); }
  .tagline {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-dim);
    margin: 18px 0 0;
    max-width: 46ch;
  }
  .spec-row {
    display: flex;
    justify-content: flex-start;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .spec {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 4px 9px;
    background: var(--panel);
  }
  .spec b { color: var(--text); font-weight: 400; }
</style>
