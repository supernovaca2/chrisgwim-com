---
import Base from '../layouts/Base.astro';
import Letterbox from '../components/Letterbox.astro';
import PosterGrid from '../components/PosterGrid.astro';
import ClassicalSeries from '../components/ClassicalSeries.astro';
import { getReleases, LANES, laneSlug, pad2, dateLong } from '../lib/releases';

const releases = await getReleases();
const latest = releases[0];
const first = releases[releases.length - 1];
const lanes = LANES.map((lane) => ({
  ...lane,
  slug: laneSlug(lane.name),
  count: releases.filter((r) => r.data.lane === lane.name).length,
})).filter((lane) => lane.count > 0);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<Base
  title="Chris Gwim — Producer"
  description={`Chris Gwim: ${releases.length} releases across ${lanes.length} lanes, from classical fusion and melodic techno to piano and synth punk. Now showing: ${latest.data.title}.`}
  current="home"
>
  <Letterbox release={latest} eyebrow={`Now showing · released ${dateLong(latest.data.datePublished)}`} linkTitle />

  <section class="wrap section" aria-labelledby="showing-h">
    <div class="section-head">
      <h2 class="section-title" id="showing-h">Also showing</h2>
      <p class="section-aside">The latest releases · <a href={`${base}music/`}>all {releases.length}</a></p>
    </div>
    <PosterGrid releases={releases.slice(1, 5)} variant="feature" />
  </section>

  <ClassicalSeries releases={releases} />

  <section class="wrap section" aria-labelledby="catalogue-h">
    <div class="section-head">
      <h2 class="section-title" id="catalogue-h">The full catalogue</h2>
      <p class="section-aside">{releases.length} releases since {dateLong(first.data.datePublished)}</p>
    </div>
    <nav class="chips" aria-label="Browse by lane">
      <a class="chip" href={`${base}music/`}>All <span class="chip-count">{pad2(releases.length)}</span></a>
      {lanes.map((lane) => (
        <a class="chip" href={`${base}music/#${lane.slug}`}>{lane.name} <span class="chip-count">{pad2(lane.count)}</span></a>
      ))}
    </nav>
    <PosterGrid releases={releases} />
  </section>

  <section class="credits" aria-labelledby="credits-h">
    <div class="wrap credits-grid">
      <img src={`${base}artist-portrait.jpg`} alt="Chris Gwim" width="480" height="640" loading="lazy" />
      <div>
        <p class="eyebrow">Written and produced by</p>
        <h2 class="credits-name" id="credits-h">Chris<br />Gwim</h2>
        <p class="credits-copy">
          A producer working in Ableton Live. The output is whatever the idea needs: melodic techno
          and trance, progressive house, solo piano, synth punk, drum and bass, soca, afrobeats.
        </p>
        <p class="credits-copy">No live dates. The work is the catalog. Press play.</p>
        <a class="btn" href={`${base}story/`}>The story →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .credits {
    margin-top: 48px;
    border-top: 1px solid var(--line);
    padding-block: 80px;
  }
  .credits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px;
    align-items: center;
  }
  .credits-grid img {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }
  .credits-name {
    margin: 0 0 24px;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(64px, 9vw, 140px);
    line-height: 0.84;
    text-transform: uppercase;
  }
  .credits-copy {
    margin: 0 0 16px;
    max-width: 50ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-soft);
  }
  .credits-copy:last-of-type { margin-bottom: 28px; }
</style>
