---
// The home page is Overworld: the catalog as a playable open world. The game
// lives in src/game (see its README); this page is its markup, with everything
// a crawler or a visitor without WebGL needs rendered here on the server: the
// name, the way to the catalog and the story, every release as a plain link,
// and the contact address in plain view.
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/geist-mono';
import '../styles/overworld.css';
import Head from '../components/Head.astro';
import { fmtDuration, dateShort } from '../lib/releases';
import { gameData } from '../lib/game-data';
import { safeJson } from '../lib/site';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const data = await gameData(base);
const { releases, links, contact } = data;
const lanes = data.lanes
  .map((lane) => ({ ...lane, tracks: releases.filter((r) => r.lane === lane.name) }))
  .filter((lane) => lane.tracks.length > 0);
const newest = releases[0];
const year = (iso: string) => iso.slice(0, 4);
---
<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Chris Gwim — Producer"
      description={`Chris Gwim: ${releases.length} releases across ${lanes.length} lanes, from classical fusion and melodic techno to piano and synth punk. Explore the catalog as an open world, or browse it as a list. Now premiering: ${newest.title}.`}
      viewport="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    {/* Two scripts, in this order. The first is the page without the game; it is small enough
        that Astro writes it into the page, so it runs even if the second never arrives. */}
    <script>
      import '../game/shell.js';
    </script>
    <script>
      import overworld from '../game/overworld.js';

      document.documentElement.dataset.game = 'on';      // shell.js looks for this mark
      // The classical series used to be a section of this page. Old links to /#series follow it.
      if (location.hash === '#series') location.replace(new URL('music/#series', document.baseURI).href);

      overworld().catch((err) => {
        console.error(err);
        document.dispatchEvent(new CustomEvent('overworld:failed', { detail: 'The 3D world could not start in this browser, so here is every release.' }));
      });
    </script>
  </head>
  {/* .booting is in the markup, not added by script, so the cover below is up from the very
      first paint. The game removes the class when the world is ready to be seen. */}
  <body class="booting">
    <div class="boot" role="status" aria-label="Loading Overworld">
      <div class="track"><i id="boot-bar"></i></div>
      {/* Shown by CSS alone after a few seconds, so it is there even when the script is what is slow. */}
      <p class="boot-late"><span class="label">Building the world</span><a href={links.catalog}>Taking a while? Browse the catalog instead.</a></p>
    </div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="rush" id="rush" aria-hidden="true"></div>
    <div class="bars" aria-hidden="true"><i></i><i></i></div>
    <div class="fade" id="fade" aria-hidden="true"></div>

    <header class="top">
      <a class="mark" href={base}>Chris Gwim</a>
      <nav class="sitenav" aria-label="Site">
        <a href={links.catalog}>Catalog</a>
        <a href={links.story}>Story</a>
      </nav>
    </header>

    <main>
      {/* Fixed behind everything; it lives in main so that it sits inside a landmark. */}
      <canvas id="scene" tabindex="-1" aria-label="A playable 3D world. Pilot a glider between Chris Gwim's releases. The track list reaches every release without playing."></canvas>
      <section class="title" id="title" aria-labelledby="title-h">
        <p class="presents">Gwim Entertainment presents</p>
        <h1 id="title-h">Chris Gwim</h1>
        <p class="sub"><b>Overworld</b><span>{releases.length} releases. {lanes.length} districts. One open world.</span></p>
        <noscript>
          <p class="noscript">Overworld is a game and needs JavaScript. Everything in it is also in <a href={links.catalog}>the catalog</a>.</p>
        </noscript>
        <ul class="menu" id="menu" hidden>
          <li><button type="button" data-act="continue" hidden>Continue <small id="menu-progress"></small></button></li>
          <li><button type="button" data-act="start">Start</button></li>
          <li><button type="button" data-act="tracks">Track list</button></li>
          <li><button type="button" data-act="sound">Sound <small id="menu-sound">On</small></button></li>
        </ul>
        <dl class="legend">
          <div class="key-only"><dt><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></dt><dd>Drive</dd></div>
          <div class="key-only"><dt><kbd>Shift</kbd></dt><dd>Boost</dd></div>
          <div class="key-only"><dt><kbd>Space</kbd></dt><dd>Drift</dd></div>
          <div class="key-only"><dt><kbd>E</kbd></dt><dd>Open a release</dd></div>
          <div class="key-only"><dt><kbd>M</kbd></dt><dd>Map</dd></div>
          <div class="key-only"><dt></dt><dd>Controllers work too</dd></div>
          <div class="touch-only"><dt></dt><dd>Left thumb steers. Right thumb boosts. Tap Open when you reach a release.</dd></div>
        </dl>

        <aside class="title-side" aria-label="The rest of the site">
          <div>
            <p class="label">Not here to play?</p>
            <nav aria-label="Browse">
              <a href={links.catalog}>Browse the catalog</a>
              <a href={links.story}>Read the story</a>
            </nav>
          </div>
          <div class="studio">
            <p class="label">Also from the studio</p>
            <nav aria-label="Studio">
              <a href={links.lunthra} target="_blank" rel="noopener">Lunthra apparel ↗</a>
              <a href={links.referral} target="_blank" rel="noopener">A free month of SoundCloud Artist Pro ↗</a>
            </nav>
          </div>
          <p class="contact">Contact <b>{contact}</b><br />© 2026 Chris Gwim</p>
        </aside>
      </section>
    </main>

    <div class="hud off" id="hud" hidden>
      <section class="quest" aria-label="Progress">
        <p class="label">Beacons lit</p>
        <p class="count" aria-live="polite"><b id="q-found">00</b><i>/</i><span id="q-total">{releases.length}</span></p>
        <ul class="lanes" id="q-lanes" aria-hidden="true"></ul>
        <p class="next" id="q-next"></p>
      </section>

      <div class="compass" id="compass" aria-hidden="true">
        <div class="ticks" id="c-ticks"></div>
        <div class="marks" id="c-marks"></div>
        <i class="needle"></i>
      </div>

      <div class="tools">
        <button class="tool" type="button" id="t-map" aria-label="Open the map"><span class="t-name">Map</span><kbd>M</kbd><svg class="t-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"></path></svg></button>
        <button class="tool" type="button" id="t-tracks" aria-label="Open the track list"><span class="t-name">Tracks</span><kbd>L</kbd><svg class="t-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"></path></svg></button>
        <button class="tool" type="button" id="t-pause" aria-label="Pause"><span class="t-name">Pause</span><kbd>Esc</kbd><svg class="t-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M8 5v14M16 5v14"></path></svg></button>
      </div>

      <canvas class="radar" id="radar" aria-hidden="true"></canvas>

      <div class="gauge" aria-hidden="true">
        <p class="speed"><b id="g-speed">0</b><span>mph</span></p>
        <div class="boost"><span class="label">Boost</span><div class="bar"><i id="g-boost"></i></div></div>
        <p class="keys" id="g-keys">
          <span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> Drive</span>
          <span><kbd>Shift</kbd> Boost</span>
          <span><kbd>Space</kbd> Drift</span>
          <span><kbd>R</kbd> Reset</span>
        </p>
      </div>

      <button class="prompt" type="button" id="prompt" hidden>
        <kbd id="pr-key">E</kbd>
        <span><small id="pr-verb">Open</small><b id="pr-title"></b></span>
      </button>

      <div class="banner" id="banner" aria-live="polite"></div>

      <div class="pad" id="pad" aria-hidden="true">
        <div class="stick" id="stick"><i id="stick-nub"></i></div>
        <div class="pad-btn" id="pad-drift">Drift</div>
        <div class="pad-btn" id="pad-boost">Boost</div>
      </div>
    </div>

    <!-- SoundCloud's own player, created only when someone presses Play here. -->
    <aside class="dock" id="dock" aria-label="Now playing" hidden>
      <div class="dock-head">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
        <button class="dock-title" type="button" id="dock-title" aria-describedby="dock-hint"></button>
        <span class="visually-hidden" id="dock-hint">Go to this release in the world</span>
        <button class="dock-close" type="button" id="dock-close" aria-label="Stop the music and close the player">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <div class="dock-frame" id="dock-frame"></div>
    </aside>

    <aside class="panel" id="panel" aria-label="Release" inert>
      <div class="panel-scroll" id="panel-body"></div>
      <div class="panel-foot">
        <div class="steps">
          <button class="ghost" type="button" id="p-prev">← Prev</button>
          <button class="ghost" type="button" id="p-next">Next →</button>
        </div>
        <button class="ghost" type="button" id="p-close" aria-label="Back to the world"><kbd>Esc</kbd> Back<span class="more"> to the world</span></button>
      </div>
    </aside>

    <section class="sheet" id="pause" aria-labelledby="pause-h" inert>
      <div class="sheet-head">
        <div><h2 id="pause-h">Paused</h2><p id="pause-sub"></p></div>
      </div>
      <div class="sheet-body pause-grid">
        <ul class="menu" id="pause-menu">
          <li><button type="button" data-act="resume">Resume</button></li>
          <li><button type="button" data-act="map">Map</button></li>
          <li><button type="button" data-act="tracks">Track list</button></li>
          <li><button type="button" data-act="sound">Sound <small id="pause-sound">On</small></button></li>
          <li><button type="button" data-act="hub">Return to the hub</button></li>
          <li><button type="button" data-act="reset">New game <small id="pause-reset"></small></button></li>
        </ul>
        <div>
          <p class="touch-help">Left thumb steers: push any way to drive, pull straight back to reverse. Hold Boost while the meter lasts, hold Drift to slide through a turn. Tap Open when you reach a release. The map and the track list can take you anywhere.</p>
          <dl class="help">
            <dt><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></dt><dd>Drive. The arrow keys work too.</dd>
            <dt><kbd>Shift</kbd></dt><dd>Boost while the meter lasts.</dd>
            <dt><kbd>Space</kbd></dt><dd>Drift: let the tail slide through a turn.</dd>
            <dt><kbd>E</kbd></dt><dd>Open the release you are parked at.</dd>
            <dt><kbd>M</kbd><kbd>L</kbd></dt><dd>Map and track list. Both can take you anywhere.</dd>
            <dt><kbd>R</kbd></dt><dd>Reset the glider onto the nearest road.</dd>
            <dt><kbd>N</kbd></dt><dd>Sound on or off.</dd>
            <dt></dt><dd>A controller works: left stick, right trigger, A to open, X to boost.</dd>
          </dl>
          <p class="contact">Contact <b>{contact}</b></p>
        </div>
      </div>
    </section>

    <!-- Rendered on the server as plain links to the release pages: this is what a crawler
         reads, and what the page becomes when the world cannot run. The game takes the
         clicks over to travel in the world instead. -->
    <section class="sheet" id="tracks" aria-labelledby="tracks-h" inert>
      <div class="sheet-head">
        <div><h2 id="tracks-h">Track list</h2><p id="tracks-sub">Every release, newest first in each lane.</p></div>
        <button class="ghost" type="button" id="tracks-close"><kbd>Esc</kbd> Close</button>
      </div>
      <div class="sheet-body">
        <div class="tl-lanes" id="tl-lanes">
          {lanes.map((lane) => (
            <section class="tl-lane" data-lane={lane.bus} data-color={lane.color}>
              <h3><b>{lane.bus}</b>{lane.name}<span>{lane.tracks.length}</span></h3>
              <ol>
                {lane.tracks.map((r) => (
                  <li>
                    <a class="tl-row" href={r.page} data-slug={r.slug} data-title={r.title}>
                      <i></i><b>{r.title}</b><span>{dateShort(r.date)}, {year(r.date)} · {fmtDuration(r.ms)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
        <p class="tl-foot" hidden>
          <a href={links.catalog}>The catalog, with cover art</a>
          <a href={links.story}>The story</a>
        </p>
        <p class="contact">Contact <b>{contact}</b></p>
      </div>
    </section>

    <section class="sheet" id="map" aria-labelledby="map-h" inert>
      <div class="sheet-head">
        <div><h2 id="map-h">Map</h2><p>Pick a district or a beacon to travel there.</p></div>
        <button class="ghost" type="button" id="map-close"><kbd>Esc</kbd> Close</button>
      </div>
      <div class="map-wrap">
        <div class="map-canvas"><canvas id="map-canvas" aria-hidden="true"></canvas></div>
        <div class="map-side" id="map-side"><p class="label">Fast travel</p></div>
      </div>
    </section>

    <script id="data" type="application/json" set:html={safeJson(data)} />
  </body>
</html>
