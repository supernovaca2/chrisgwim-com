---
import Base from '../layouts/Base.astro';
import { getReleases, LANES, laneSlug, pad2, classicalSeries, dateLong } from '../lib/releases';

const releases = await getReleases();
const first = releases[releases.length - 1];
const latest = releases[0];
const lanes = LANES.map((lane) => ({
  ...lane,
  slug: laneSlug(lane.name),
  tracks: releases.filter((r) => r.data.lane === lane.name),
})).filter((lane) => lane.tracks.length > 0);
// Oldest first reads like a career, and keeps the copy true as the series grows.
const seriesTitles = classicalSeries(releases).reverse().map((s) => s.release.data.title);
const seriesList = seriesTitles.length > 1
  ? `${seriesTitles.slice(0, -1).join(', ')} and ${seriesTitles.at(-1)}`
  : seriesTitles[0];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const monthYear = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Story — Chris Gwim"
  description="Who Chris Gwim is: a producer working in Ableton Live across classical fusion, techno, house, piano, punk and world music."
  current="story"
>
  <section class="wrap story" aria-labelledby="story-h">
    <img class="portrait" src={`${base}artist-portrait.jpg`} alt="Chris Gwim" width="480" height="640" />
    <div class="story-copy">
      <p class="eyebrow">Written and produced by</p>
      <h1 class="story-title" id="story-h">Chris<br />Gwim</h1>
      <p>
        Chris Gwim is a producer. The instrument is Ableton Live; the output is whatever
        the idea needs. {pad2(releases.length)} releases since {monthYear(first.data.datePublished)}:
        melodic techno and trance, progressive house, solo piano, synth punk, drum and bass,
        soca, afrobeats.
      </p>
      {seriesList && (
        <p>
          The current lane is classical fusion. {seriesList} take a symphonic motif, keep its
          shape, and rebuild it at club tempo. More composers are in the queue.
        </p>
      )}
      <p>No live dates. The work is the catalog. Press play.</p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="facts-h">
    <div class="section-head">
      <h2 class="section-title" id="facts-h">The facts</h2>
      <p class="section-aside">As of {dateLong(latest.data.datePublished)}</p>
    </div>
    <dl class="facts">
      <div><dt>Instrument</dt><dd>Ableton Live</dd></div>
      <div><dt>Releases</dt><dd class="tabular">{pad2(releases.length)}</dd></div>
      <div><dt>Lanes</dt><dd class="tabular">{pad2(lanes.length)}</dd></div>
      <div><dt>First release</dt><dd>{dateLong(first.data.datePublished)}</dd></div>
      <div><dt>Latest</dt><dd>{dateLong(latest.data.datePublished)}</dd></div>
      <div><dt>Label</dt><dd><a href="https://gwimentertainment.com" target="_blank" rel="noopener">Gwim Entertainment</a></dd></div>
    </dl>
  </section>

  <section class="wrap section" aria-labelledby="lanes-h">
    <div class="section-head">
      <h2 class="section-title" id="lanes-h">The lanes</h2>
      <p class="section-aside">Every track sits in one</p>
    </div>
    <ol class="lanes">
      {lanes.map((lane) => (
        <li>
          <a href={`${base}music/#${lane.slug}`}>
            <span class="lane-name">{lane.name}</span>
            <span class="lane-count tabular">{pad2(lane.tracks.length)}</span>
            <span class="lane-tracks">{lane.tracks.map((r) => r.data.title).join(' · ')}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section press" aria-labelledby="press-h">
    <div class="section-head">
      <h2 class="section-title" id="press-h">Press &amp; licensing</h2>
    </div>
    <p>
      Cover art on every release page is served at 500 px. For hi-res art, a bio, or a
      sync inquiry, use the contact address in the footer.
    </p>
  </section>
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px;
    align-items: center;
    padding-block: 64px 24px;
  }
  .portrait {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }
  .story-title {
    margin: 0 0 28px;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(72px, 10vw, 160px);
    line-height: 0.84;
    text-transform: uppercase;
  }
  .story-copy p:not(.eyebrow),
  .press p {
    margin: 0 0 16px;
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px;
    margin: 0;
  }
  .facts div {
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
  }
  .facts dt {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .facts dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: 30px;
    line-height: 1;
    text-transform: uppercase;
  }
  .facts a { text-decoration: none; }
  .facts a:hover,
  .facts a:focus-visible { color: var(--accent); }
  .lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .lanes a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .lane-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    text-transform: uppercase;
  }
  .lane-count {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    color: var(--accent);
  }
  .lane-tracks {
    grid-column: 1 / -1;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dim);
  }
  .lanes a:hover .lane-name,
  .lanes a:focus-visible .lane-name { color: var(--accent); }
</style>
