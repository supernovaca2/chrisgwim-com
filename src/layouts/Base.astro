---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/instrument-sans';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Studio from '../components/Studio.astro';
import { getReleases, PLATFORMS } from '../lib/releases';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to the share image. Defaults to the portrait. */
  ogImage?: string;
  /** Extra JSON-LD for the page (a MusicRecording on release pages). */
  jsonLd?: Record<string, unknown>;
  /** Which nav item is current. */
  current?: 'home' | 'music' | 'story';
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}
const { title, description, ogImage = '/artist-portrait.jpg', jsonLd, current, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const site = Astro.site ?? new URL('https://chrisgwim.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImageAbs = new URL(ogImage, site).toString();
const releases = await getReleases();

// Shown as visible footer text, not just a mailto href: Spotify for Artists
// reviewers need to SEE the address next to the artist to verify a request.
const CONTACT_EMAIL = 'chrisgwim@chrisgwim.com';

const musicGroup = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Chris Gwim',
  url: site.toString(),
  email: CONTACT_EMAIL,
  image: ogImageAbs,
  genre: ['Electronic', 'Techno', 'Classical Fusion', 'House', 'Piano'],
  sameAs: PLATFORMS.map((p) => p.url),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chris Gwim" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(musicGroup)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Studio referral={current === 'home'} />
    <footer class="footer">
      <div class="wrap">
        <p class="billing">
          {['Gwim Entertainment presents a Chris Gwim production', ...releases.map((r) => r.data.title)].join(' · ')}
        </p>
        <ul class="platforms">
          {PLATFORMS.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener">
                {p.name}
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
              </a>
            </li>
          ))}
        </ul>
        <p class="footer-line">
          <span>Contact <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span>
          <span>© 2026 Chris Gwim</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 10;
    padding: 12px 16px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus { top: 12px; }
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 56px;
    text-align: center;
  }
  /* A film poster's billing block: every title, set tall and tight. */
  .billing {
    max-width: 1100px;
    margin: 0 auto 28px;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(16px, 1.8vw, 24px);
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #c9ccd1;
    text-wrap: balance;
  }
  .platforms {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 22px;
  }
  .platforms a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .platforms svg { color: var(--text-dim); }
  .platforms a:hover,
  .platforms a:focus-visible { color: var(--accent); }
  .footer-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin: 0;
    font-size: 14px;
    color: var(--text-dim);
  }
  .footer-line a { color: var(--text); }
  .footer-line a:hover,
  .footer-line a:focus-visible { color: var(--accent); }
</style>
