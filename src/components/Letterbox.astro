---
// The premiere: a release's art cropped to 2.39:1 between black bars, its
// title set large underneath, and the SoundCloud player beside it.
import type { Release } from '../lib/releases';
import { fmtDuration, platformName, playerSrc } from '../lib/releases';
import { coverWide } from '../lib/images';

interface Props {
  release: Release;
  eyebrow: string;
  /** h1 on a release page and the home page's lead release. */
  level?: 1 | 2;
  /** Link the title to the release page (the home page's lead release). */
  linkTitle?: boolean;
}
const { release, eyebrow, level = 1, linkTitle = false } = Astro.props;
const { title, cover, primaryUrl, soundcloudUrl, genre, lane, durationMs, soundcloudId } = release.data;
const Heading = level === 1 ? 'h1' : 'h2';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const releaseHref = `${base}music/${release.id}/`;
const onSoundCloud = primaryUrl.includes('soundcloud.com');
---
<section class="letterbox" aria-labelledby={`lb-${release.id}`}>
  <div class="bar" aria-hidden="true"></div>
  <div class="frame">
    <img src={coverWide(cover, base)} alt={`${title} cover art`} width="1200" height="502" fetchpriority="high" />
  </div>
  <div class="wrap band">
    <div class="band-copy">
      <p class="eyebrow">{eyebrow}</p>
      <Heading class="title" id={`lb-${release.id}`}>
        {linkTitle ? <a href={releaseHref}>{title}</a> : title}
      </Heading>
      <p class="meta tabular">{genre}{genre !== lane && ` · ${lane}`} · {fmtDuration(durationMs)}</p>
      <div class="actions">
        <a class="btn btn-primary" href={soundcloudUrl} target="_blank" rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M7 4.5v15l12-7.5z"></path></svg>
          SoundCloud
        </a>
        {!onSoundCloud && <a class="btn" href={primaryUrl} target="_blank" rel="noopener">{platformName(primaryUrl)} ↗</a>}
        <slot name="actions" />
      </div>
    </div>
    <div class="player">
      {/* Sandboxed: the player may run its scripts and open soundcloud.com in a new tab. It may not navigate this page. */}
      <iframe
        loading="lazy"
        scrolling="no"
        allow="autoplay"
        sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        referrerpolicy="strict-origin-when-cross-origin"
        title={`${title} by Chris Gwim on SoundCloud`}
        src={playerSrc(soundcloudId)}></iframe>
    </div>
  </div>
</section>

<style>
  .letterbox { background: #000; }
  .bar { height: clamp(14px, 3vw, 40px); }
  .frame {
    max-width: 1920px;
    margin: 0 auto;
    aspect-ratio: 2.39 / 1;
    overflow: hidden;
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .frame img { animation: open 0.9s ease-out; }
  }
  @keyframes open {
    from { opacity: 0; transform: scale(1.03); }
    to { opacity: 1; transform: scale(1); }
  }
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    align-items: end;
    gap: 28px 48px;
    padding-block: 28px 48px;
  }
  @media (max-width: 1000px) {
    .band { grid-template-columns: minmax(0, 1fr); }
  }
  .band-copy { min-width: 0; }
  .title {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(56px, 9vw, 168px);
    line-height: 0.86;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .title a { text-decoration: none; }
  .title a:hover,
  .title a:focus-visible { color: var(--accent); }
  .meta {
    margin: 14px 0 24px;
    font-size: 16px;
    color: var(--text-dim);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
