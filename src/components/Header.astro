---
interface Props {
  current?: 'music' | 'story';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const nav = [
  { key: 'home', label: 'Wave Invasion', href: base },
  { key: 'series', label: 'Classical series', href: `${base}music/#series` },
  { key: 'music', label: 'Catalog', href: `${base}music/` },
  { key: 'story', label: 'Story', href: `${base}story/` },
];
---
<header class="header">
  <a class="wordmark" href={base}>Chris Gwim</a>
  <nav class="nav" aria-label="Site">
    {nav.map((item) => (
      <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
    padding: 8px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .wordmark {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--display);
    font-weight: 900;
    font-size: 26px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    margin-inline: -10px;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav a:hover,
  .nav a:focus-visible { color: var(--text); }
  .nav a[aria-current="page"] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>
